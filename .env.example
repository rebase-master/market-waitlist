# Copy to .env.local and fill in. NEVER commit real values (.env*.local is gitignored).

# Supabase project URL — safe to expose to the browser.
# Dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"

# Supabase service-role key — SERVER ONLY. It bypasses Row Level Security and is
# used exclusively by the /api/waitlist route to insert signups. Never prefix it
# with NEXT_PUBLIC_ and never send it to the browser.
# Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"

# Canonical site origin — used for metadata, canonical URL, sitemap, and OG tags.
# No trailing slash. In Vercel this is set per-environment.
NEXT_PUBLIC_SITE_URL="https://amanah.example.com"
